# Keep these variables server-only. Do not prefix them with NEXT_PUBLIC_.
# Get an API key with Sending access for xachmedia.com from Resend.
RESEND_API_KEY=

# Bare email address on your verified Resend domain (no display name).
RESEND_FROM_EMAIL=info@xachmedia.com

# Inbox that receives website enquiries. This mailbox must already work.
# You can use xachmedia@gmail.com here if your custom inbox is not set up yet.
CONTACT_TO_EMAIL=info@xachmedia.com
